# Used by scene_script + prompt_maker. DeepSeek by default -- faster and more
# reliable than self-hosted Qwen turned out to be in practice. If you have your
# own local vLLM server instead, point this at it: LLM_BASE_URL=http://localhost:8800/v1,
# LLM_API_KEY=not-needed, LLM_MODEL=qwen2.5-72b-instruct-awq (or your served model).
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-api-key-here
LLM_MODEL=deepseek-v4-flash
TTS_VOICE=af_heart

# Code-generation-specific LLM (scene_coder) -- optional, falls back to the LLM_*
# settings above if unset. Currently the same DeepSeek endpoint as above; kept as
# a separate override in case scene_coder ever needs a different model again.
CODE_LLM_BASE_URL=https://api.deepseek.com/v1
CODE_LLM_API_KEY=your-deepseek-api-key-here
CODE_LLM_MODEL=deepseek-v4-flash
